msgid "Please confirm your new e-mail address"
msgstr "Пожалуйста, подтвердите свой новый адрес электронной почты"

#. emails.emailChangeConfirm.title
msgid "Confirm new e-mail address"
msgstr "Подтвердить новый адрес электронной почты"

