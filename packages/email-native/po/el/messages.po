#. emails.accountMultiRegistration.contactSupport
msgid "Contact support"
msgstr "Επικοινωνία με την υποστήριξη"

#. emails.accountMultiRegistration.emailExists
msgid "However, an account already exists for your email address."
msgstr "Ωστόσο, υπάρχει ήδη λογαριασμός για τη διεύθυνση email σου."

#. emails.accountMultiRegistration.emailReused
msgid "Your email address has just been used again to register an account with Gradido."
msgstr "η διεύθυνση email σου μόλις χρησιμοποιήθηκε ξανά για την εγγραφή λογαριασμού στο Gradido."

#. emails.accountMultiRegistration.ifYouAreNotTheOne
msgid "If you did not try to register again, please contact our support:"
msgstr "Αν δεν προσπάθησες να εγγραφείς ξανά, επικοινώνησε με την υποστήριξή μας:"

#. emails.accountMultiRegistration.onForgottenPasswordClickLink
msgid "If you have forgotten your password, please click here."
msgstr "Αν ξέχασες τον κωδικό πρόσβασής σου, κάνε κλικ εδώ."

#. emails.accountMultiRegistration.subject
#. emails.accountMultiRegistration.title
msgid "Try To Register Again With Your Email"
msgstr "Νέα προσπάθεια εγγραφής με το email σου"

#. emails.addedContributionMessage.commonGoodContributionMessage
msgid "You have received a message from %1 regarding your common good contribution “%2”."
msgstr "έλαβες ένα μήνυμα από %1 σχετικά με τη συνεισφορά σου στο κοινό καλό «%2»."

#. emails.addedContributionMessage.contributionClosed
msgid "This contribution is complete — you cannot reply here any more."
msgstr "Αυτή η συνεισφορά έχει ολοκληρωθεί — δεν μπορείς να απαντήσεις εδώ πια."

#. emails.addedContributionMessage.message
msgid "„%1“"
msgstr "«%1»"

#. emails.addedContributionMessage.readMessage
msgid "Read and reply to message"
msgstr "Διάβασε και απάντησε στο μήνυμα"

#. emails.addedContributionMessage.readMessageOnly
msgid "Read message"
msgstr "Διάβασε το μήνυμα"

#. emails.addedContributionMessage.subject
#. emails.addedContributionMessage.title
msgid "Message about your common good contribution"
msgstr "Μήνυμα σχετικά με τη συνεισφορά σου στο κοινό καλό"

#. emails.addedContributionMessage.toSeeAndAnswerMessage
msgid "You can reply directly at your contribution."
msgstr "Μπορείς να απαντήσεις απευθείας στη συνεισφορά σου."

#. emails.assistedRegistrationConfirm.accountCreated
msgid "Together with a Gradido member, an account has just been set up for you — with this e-mail address."
msgstr "Μαζί με ένα μέλος Gradido μόλις δημιουργήθηκε ένας λογαριασμός για σένα — με αυτή τη διεύθυνση email."

#. emails.assistedRegistrationConfirm.accountCreatedByThanks
msgid "On acceptance of a thank-you, an account has just been set up for you — with this e-mail address."
msgstr "Κατά την αποδοχή ενός ευχαριστώ μόλις δημιουργήθηκε ένας λογαριασμός για σένα — με αυτή τη διεύθυνση email."

#. emails.assistedRegistrationConfirm.clickToConfirm
msgid "Please click here to confirm your e-mail address."
msgstr "Κάνε κλικ εδώ για να επιβεβαιώσεις τη διεύθυνση email σου."

#. emails.assistedRegistrationConfirm.confirmButton
msgid "Confirm address"
msgstr "Επιβεβαίωση διεύθυνσης"

#. emails.assistedRegistrationConfirm.confirmHeading
msgid "Confirm e-mail address"
msgstr "Επιβεβαίωση διεύθυνσης email"

#. emails.assistedRegistrationConfirm.linkValidity [1/2]
#. emails.general.linkValidity [1/2]
msgid "The link has a validity of %1 hours."
msgstr "Ο σύνδεσμος ισχύει για %1 ώρες."

#. emails.assistedRegistrationConfirm.linkValidity [2/2]
#. emails.assistedRegistrationConfirm.linkValidityWithMinutes [2/2]
msgid "If the validity of the link has already expired, sign in and have a new mail sent to you."
msgstr "Αν η ισχύς του συνδέσμου έχει ήδη λήξει, συνδέσου και ζήτησε να σου σταλεί νέο e-mail."

#. emails.assistedRegistrationConfirm.linkValidityWithMinutes [1/2]
#. emails.general.linkValidityWithMinutes [1/2]
msgid "The link has a validity of %1 hours and %2 minutes."
msgstr "Ο σύνδεσμος ισχύει για %1 ώρες και %2 λεπτά."

#. emails.assistedRegistrationConfirm.notYou
msgid "You know nothing about this account? Then ignore this e-mail — without confirmation the account stays locked."
msgstr "Δεν γνωρίζεις τίποτα για αυτόν τον λογαριασμό; Τότε αγνόησε αυτό το email — χωρίς επιβεβαίωση ο λογαριασμός παραμένει κλειστός."

#. emails.assistedRegistrationConfirm.pleaseConfirm
msgid "Please confirm that this address is yours — only then will your account stay open for good."
msgstr "Επιβεβαίωσε ότι αυτή η διεύθυνση είναι δική σου — μόνο τότε ο λογαριασμός σου θα παραμείνει μόνιμα ανοιχτός."

#. emails.assistedRegistrationConfirm.subject
msgid "Confirm your e-mail address"
msgstr "Επιβεβαίωσε τη διεύθυνση email σου"

#. emails.assistedRegistrationConfirm.title
msgid "Your Gradido account is ready"
msgstr "Ο λογαριασμός σου Gradido είναι έτοιμος"

#. emails.chatGroupAdded.inTheGroup
msgid "%1 members write to each other in the group. All members see your username."
msgstr "στην ομάδα γράφουν μεταξύ τους %1 μέλη. Όλα τα μέλη βλέπουν το όνομα χρήστη σου."

#. emails.chatGroupAdded.leaveAnyTime
msgid "You can mute or leave the group in your Gradido account at any time."
msgstr "Μπορείς οποιαδήποτε στιγμή να θέσεις την ομάδα σε σίγαση ή να αποχωρήσεις από αυτήν στον λογαριασμό σου Gradido."

#. emails.chatGroupAdded.openGroup
msgid "Open group"
msgstr "Άνοιξε την ομάδα"

#. emails.chatGroupAdded.subject
msgid "You are now in the group “%1”"
msgstr "Είσαι πλέον στην ομάδα «%1»"

#. emails.chatGroupAdded.title
msgid "%1 has added you to the group “%2”"
msgstr "%1 σε πρόσθεσε στην ομάδα «%2»"

#. emails.chatGroupMessage.announcement
msgid "%1 has sent a message to all members of the group as an announcement."
msgstr "%1 έστειλε ένα μήνυμα ως ανακοίνωση σε όλα τα μέλη της ομάδας."

#. emails.chatGroupMessage.muteHint
msgid "No more announcements by email? Tap the bell in the group in your Gradido account."
msgstr "Δεν θέλεις άλλες ανακοινώσεις με email; Πάτησε το καμπανάκι στην ομάδα, στον λογαριασμό σου Gradido."

#. emails.chatGroupMessage.subject
msgid "Announcement in “%1” from %2"
msgstr "Ανακοίνωση στην ομάδα «%1» από %2"

#. emails.chatGroupMessage.title
msgid "%1 writes in “%2”"
msgstr "%1 γράφει στην ομάδα «%2»"

#. emails.contribution.toSeeContributionsAndMessages
msgid "You will find your common good contributions and the messages about them in your Gradido account."
msgstr "Τις συνεισφορές σου στο κοινό καλό και τα σχετικά μηνύματα θα τις βρεις στον λογαριασμό σου στο Gradido."

#. emails.contributionChangedByModerator.subject
#. emails.contributionChangedByModerator.title
msgid "Your common good contribution has been changed"
msgstr "Η συνεισφορά σου στο κοινό καλό άλλαξε"

#. emails.contributionChangedByModerator.text
msgid "your common good contribution '%1' has just been changed by %2 and now reads as '%3'"
msgstr "η συνεισφορά σου στο κοινό καλό «%1» μόλις άλλαξε από %2 και τώρα είναι «%3»"

#. emails.contributionConfirmed.commonGoodContributionConfirmed
msgid "Your common good contribution “%1” has just been approved by %2. Your Gradido account has been credited with %3 GDD."
msgstr "η συνεισφορά σου στο κοινό καλό «%1» μόλις επιβεβαιώθηκε από %2. Στον λογαριασμό σου στο Gradido πιστώθηκαν %3 GDD."

#. emails.contributionConfirmed.subject
#. emails.contributionConfirmed.title
msgid "Your contribution to the common good was confirmed"
msgstr "Η συνεισφορά σου στο κοινό καλό επιβεβαιώθηκε"

#. emails.contributionDeleted.commonGoodContributionDeleted
msgid "Your common good contribution “%1” was deleted by %2."
msgstr "η συνεισφορά σου στο κοινό καλό «%1» διαγράφηκε από %2."

#. emails.contributionDeleted.subject
#. emails.contributionDeleted.title
msgid "Your common good contribution was deleted"
msgstr "Η συνεισφορά σου στο κοινό καλό διαγράφηκε"

#. emails.contributionDenied.commonGoodContributionDenied
msgid "Your common good contribution “%1” was rejected by %2."
msgstr "η συνεισφορά σου στο κοινό καλό «%1» απορρίφθηκε από %2."

#. emails.contributionDenied.subject
#. emails.contributionDenied.title
msgid "Your common good contribution was rejected"
msgstr "Η συνεισφορά σου στο κοινό καλό απορρίφθηκε"

