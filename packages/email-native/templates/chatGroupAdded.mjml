<!--
  A member was taken into a chat group: sent once, to them. The group's name is a
  member's own writing and is escaped like every value.

  How the markers, the includes and the preview settings work is written once, in
  accountActivation.mjml.
-->
<mjml lang="{{v:locale}}">
  <mj-head>
    <mj-include path="includes/head.mjml" />
    <mj-title>{{t:You are now in the group “%1”|groupTitle}}</mj-title>
  </mj-head>

  <mj-body>
    <mj-include path="includes/top.mjml" />

    <mj-section padding="15px 25px 0 25px">
      <mj-column>
        <mj-text mj-class="h2">{{t:%1 has added you to the group “%2”|adderAlias,groupTitle}}</mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="20px 25px 0 25px">
      <mj-column>
        <mj-include path="includes/salutation.mjml" />
        <mj-text mj-class="muted">{{t:%1 members write to each other in the group. All members see your username.|memberCount}}</mj-text>
      </mj-column>
    </mj-section>

    <!-- The way in is the group itself: the contact page opens its window with the group
         the address names. Leaving and muting are there too. -->
    <mj-wrapper background-color="#f5f5f5" border="1px solid #808080" border-radius="24px" padding="20px 8% 40px 8%">
      <mj-section background-color="#f5f5f5">
        <mj-column>
          <mj-text mj-class="h2" padding="20px 0 0 0">{{v:groupTitle}}</mj-text>
          <mj-button mj-class="btn-answer" css-class="btn-green" background-color="#53900c"
                      href="{{v:communityURL}}/contacts?group={{v:groupUuid}}">{{t:Open group}}</mj-button>
          <mj-text mj-class="p-content" padding="15px 0 15px 0">{{t:You can mute or leave the group in your Gradido account at any time.}}</mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <mj-section padding="0 25px">
      <mj-column>
        <mj-button mj-class="btn" css-class="btn-gold" background-color="#c58d38"
                    href="{{v:communityURL}}/transactions">{{t:To account}}</mj-button>
      </mj-column>
    </mj-section>

    <mj-include path="includes/bottom.mjml" />
  </mj-body>
</mjml>
