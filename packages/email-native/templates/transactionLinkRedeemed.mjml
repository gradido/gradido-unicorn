<!--
  Somebody accepted a thank-you link the receiver sent.

  How the markers, the includes and the preview settings work is written once, in
  accountActivation.mjml.
-->
<mjml lang="{{v:locale}}">
  <mj-head>
    <mj-include path="includes/head.mjml" />
    <mj-title>{{t:%1 has accepted your thank-you|senderAlias}}</mj-title>
  </mj-head>

  <mj-body>
    <mj-include path="includes/top.mjml" />

    <mj-section padding="15px 25px 0 25px">
      <mj-column>
        <mj-text mj-class="h2">{{t:%1 has accepted your thank-you|senderAlias}}</mj-text>
      </mj-column>
    </mj-section>

    <!-- One sentence of the catalogue says the news, and for somebody who opened their
         account with this link the sentence itself says so: every language wants the
         arrival in a place of its own, so nothing is joined on here. -->
    <mj-section padding="20px 25px 0 25px">
      <mj-column>
        <mj-include path="includes/salutation.mjml" />
        <mj-text mj-class="muted">{{if newMember}}{{t:%1 (%2) has just accepted your thank-you — and is new to Gradido. How lovely that you showed it.|senderAlias,senderCommunity}}{{else}}{{t:%1 (%2) has just accepted your thank-you.|senderAlias,senderCommunity}}{{end}}</mj-text>
      </mj-column>
    </mj-section>

    <mj-wrapper background-color="#f5f5f5" border="1px solid #808080" border-radius="24px" padding="20px 8% 40px 8%">
      <mj-section background-color="#f5f5f5">
        <mj-column>
          <mj-text mj-class="h2" padding="20px 0 0 0">{{t:Transaction details}}</mj-text>
          <mj-text mj-class="p-content" css-class="human-text" padding="15px 0 15px 0">
            {{t:Amount: %1 GDD|transactionAmount}}<br />
            {{t:Message: %1|h:transactionMemo}}<br />
            {{t:You can find transaction details in your Gradido account.}}
          </mj-text>

          <!-- The way to the person who accepted: their conversation, green and inside the
               card like every button that leads to a person, above the gold way into the
               account. Each id is one URI component: across the border it is what the
               other server answered with. Without both there is no such way. -->
          {{if senderCommunityUuid && senderUuid}}
          <mj-button mj-class="btn-answer" css-class="btn-green" background-color="#53900c"
                      href="{{v:communityURL}}/contacts?with={{u:senderUuid}}&amp;community={{u:senderCommunityUuid}}">{{t:Conversation}}</mj-button>
          {{end}}
          <mj-button mj-class="btn" css-class="btn-gold" background-color="#c58d38"
                      href="{{v:communityURL}}/transactions">{{t:To account}}</mj-button>
          <mj-include path="includes/do-not-reply.mjml" />
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <mj-include path="includes/bottom.mjml" />
  </mj-body>
</mjml>
