<!--
  An announcement in a chat group: the owner or a moderator sent a message to every
  member as a mail as well; only members who did not mute the group get it. A picture
  is not in the mail, a line says there is one -- as in customEmail.

  How the markers, the includes and the preview settings work is written once, in
  accountActivation.mjml.
-->
<mjml lang="{{v:locale}}">
  <mj-head>
    <mj-include path="includes/head.mjml" />
    <mj-title>{{t:Announcement in “%1” from %2|groupTitle,senderAlias}}</mj-title>
  </mj-head>

  <mj-body>
    <mj-include path="includes/top.mjml" />

    <mj-section padding="15px 25px 0 25px">
      <mj-column>
        <mj-text mj-class="h2">{{t:%1 writes in “%2”|senderAlias,groupTitle}}</mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="20px 25px 0 25px">
      <mj-column>
        <mj-include path="includes/salutation.mjml" />
        <mj-text mj-class="muted">{{t:%1 has sent a message to all members of the group as an announcement.|senderAlias}}</mj-text>
      </mj-column>
    </mj-section>

    <mj-wrapper background-color="#f5f5f5" border="1px solid #808080" border-radius="24px" padding="20px 8% 40px 8%">
      <mj-section background-color="#f5f5f5">
        <mj-column>
          <mj-text mj-class="h2" padding="20px 0 0 0">{{t:Message}}</mj-text>
          {{if hasImage}}
          <mj-text mj-class="p-content" align="left">{{t:📷 The message contains a picture – you can see it in the conversation.}}</mj-text>
          {{end}}
          <!-- Bold as in the thread. -->
          {{if memo}}
          <mj-text mj-class="p-content" css-class="human-text" align="left">{{hb:memo}}</mj-text>
          {{end}}
          <!-- The reply is written in the group, and the bell to mute it is there too. -->
          <mj-button mj-class="btn-answer" css-class="btn-green" background-color="#53900c"
                      href="{{v:communityURL}}/contacts?group={{v:groupUuid}}">{{t:Reply}}</mj-button>
          <mj-text mj-class="p-content" padding="15px 0 15px 0">{{t:No more announcements by email? Tap the bell in the group in your Gradido account.}}</mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <mj-section padding="0 25px">
      <mj-column>
        <mj-button mj-class="btn" css-class="btn-gold" background-color="#c58d38"
                    href="{{v:communityURL}}/transactions">{{t:To account}}</mj-button>
      </mj-column>
    </mj-section>

    <mj-include path="includes/bottom.mjml" />
  </mj-body>
</mjml>
